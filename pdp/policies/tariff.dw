// Политики write-пути: Prepare → ConfirmCard → Execute (deny by default).
// Услуги и контакты лимит не расходуют — forbid только на tariff_change.

permit (
  principal,
  action == Tel::Action::"Prepare",
  resource
) when {
  context.input.role == "client" &&
  context.input.scopes.contains("tariffs:write") &&
  context.input.guard_ok
};

permit (
  principal,
  action == Tel::Action::"ConfirmCard",
  resource
) when {
  context.input.guard_ok &&
  temporal {
    formerly within 1h
      Tel::Action::"Prepare"::request{ input.pending_id: context.input.pending_id }
  }
};

permit (
  principal,
  action == Tel::Action::"Execute",
  resource
) when {
  context.input.guard_ok &&
  temporal {
    formerly within 1h
      Tel::Action::"ConfirmCard"::request{ input.pending_id: context.input.pending_id }
  }
};

forbid (
  principal,
  action == Tel::Action::"Execute",
  resource
) when {
  context.input.action == "tariff_change" &&
  temporal {
    count_within(24h, Tel::Action::"Execute"::request{ input.action: "tariff_change" }) > 2
  }
};
