# Рекомендуемый профиль (боевой): облачная модель с tool calls — primary.
# Ключ только в локальном .env, в репозиторий не коммитить.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3-flash-preview
LLM_API_KEY=

# Стоимость диалога (бюджет сессии) — цена за 1M токенов, рублей
LLM_PRICE_RUB_PER_1M=20
BUDGET_RUB=50

# Postgres контура (docker-compose)
PG_DSN=postgresql://operator:operator@127.0.0.1:5434/operator

# Порты сервисов (менять не обязательно)
STAND_PORT=8100
BACKEND_PORT=8000
ACTIONS_PORT=8220
PDP_PORT=9100
GUARDRAIL_PORT=8300

# Жизнь токена сессии и карточки подтверждения, секунды
TOKEN_TTL_SEC=3600
CARD_TTL_SEC=120

# Запасной провайдер: локальная модель (Ollama / LM Studio). Пул включается сам.
# Без облака можно поменять местами: локальную поставить в LLM_* выше, а эти строки закомментировать.
LLM_SECONDARY_BASE_URL=http://127.0.0.1:11434/v1
LLM_SECONDARY_MODEL=qwen2.5:7b
LLM_SECONDARY_API_KEY=none
LLM_SECONDARY_PRICE_RUB_PER_1M=60
LLM_FAILOVER_COOLDOWN_SEC=60

# Локальный профиль без облака (раскомментируй и закомментируй блок primary выше):
#LLM_BASE_URL=http://127.0.0.1:11434/v1
#LLM_MODEL=qwen2.5:7b
#LLM_API_KEY=none
#LLM_PRICE_RUB_PER_1M=60
#LLM_SECONDARY_BASE_URL=
#LLM_SECONDARY_MODEL=
#LLM_SECONDARY_API_KEY=
