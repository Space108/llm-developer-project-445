# LLM: любой OpenAI-совместимый API. Локально — LM Studio (http://127.0.0.1:1234/v1),
# в демо — облачный провайдер: меняются только эти четыре переменные.
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=gemma-4-e4b-it
LLM_API_KEY=none

# Стоимость диалога (бюджет сессии) — цена за 1M токенов, рублей
LLM_PRICE_RUB_PER_1M=60
BUDGET_RUB=50

# Postgres контура (docker-compose)
PG_DSN=postgresql://operator:operator@127.0.0.1:5434/operator

# Порты сервисов (менять не обязательно)
STAND_PORT=8100
BACKEND_PORT=8000
ACTIONS_PORT=8220
PDP_PORT=9100
GUARDRAIL_PORT=8300

# Жизнь токена сессии и карточки подтверждения, секунды
TOKEN_TTL_SEC=3600
CARD_TTL_SEC=120

# ── Бонус-шаг: multi-provider failover ───────────────────────────────────
# Задайте LLM_SECONDARY_BASE_URL — пул включается автоматически.
# Пример запасного: Gemini OpenAI-совместимый endpoint.
#LLM_SECONDARY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#LLM_SECONDARY_MODEL=gemini-3-flash-preview
#LLM_SECONDARY_API_KEY=
#LLM_SECONDARY_PRICE_RUB_PER_1M=20
#LLM_FAILOVER_COOLDOWN_SEC=60
